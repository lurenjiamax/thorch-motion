"""Run SensorsPD before RootPD; fail the unit if either daemon exits."""
import signal
import argparse
import json
from pathlib import Path
import os
import socket
import subprocess
import sys
import time


def notify(message: str) -> None:
    address = os.environ.get('NOTIFY_SOCKET')
    if not address:
        return
    if address.startswith('@'):
        address = '\0' + address[1:]
    with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as connection:
        connection.connect(address)
        connection.sendall(message.encode())


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('runtime')
    parser.add_argument('--profile', type=Path)
    options = parser.parse_args()
    profile = json.loads(options.profile.read_text()) if options.profile else {
        'fastrpc_device': '/dev/fastrpc-adsp', 'dsp_domain': 'adsp'}
    device = profile['fastrpc_device']
    domain = profile['dsp_domain']
    if not isinstance(device, str) or not device.startswith('/dev/') or domain not in ('adsp', 'sdsp'):
        raise ValueError('Unsupported FastRPC device or DSP domain')
    if profile.get('startup_order', ['SensorsPD', 'RootPD']) != ['SensorsPD', 'RootPD']:
        raise ValueError('This supervisor supports SensorsPD then RootPD only')
    stopping = False
    children: list[subprocess.Popen] = []

    def stop(signum: int, frame: object) -> None:
        nonlocal stopping
        stopping = True

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    command = ['/usr/lib/thorch-motion/hexagonrpcd', '-f', device,
               '-d', domain, '-R', options.runtime]
    try:
        children.append(subprocess.Popen(command + ['-s']))
        deadline = time.monotonic() + 1
        while time.monotonic() < deadline and not stopping:
            if children[0].poll() is not None:
                return 1
            time.sleep(0.05)
        if stopping:
            return 0
        children.append(subprocess.Popen(command))
        notify('STATUS=Waiting for SSC accelerometer and gyroscope samples')
        ready = False
        deadline = time.monotonic() + 60
        while not stopping and time.monotonic() < deadline:
            ready = True
            for sensor in ('accelerometer', 'gyroscope'):
                if stopping or any(child.poll() is not None for child in children):
                    return 0 if stopping else 1
                probe = subprocess.Popen(
                    ['/usr/bin/thorch-motion-capture', '--sensor', sensor,
                     '--sample-rate=25', '--timeout=2'],
                    stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
                probe_deadline = min(deadline, time.monotonic() + 8)
                output = ''
                try:
                    while not stopping and time.monotonic() < probe_deadline:
                        if any(child.poll() is not None for child in children):
                            return 1
                        try:
                            output, _ = probe.communicate(timeout=.1)
                            break
                        except subprocess.TimeoutExpired:
                            pass
                finally:
                    if probe.poll() is None:
                        probe.kill()
                    remaining_output, _ = probe.communicate()
                    output = remaining_output or output
                if stopping:
                    return 0
                if probe.returncode != 0 or 'sensor measurement: X=' not in output:
                    ready = False
                    break
            if ready:
                break
            time.sleep(.2)
        if stopping:
            return 0
        if not ready:
            notify('STATUS=SSC samples unavailable after startup deadline')
            return 1
        notify('READY=1\nSTATUS=SSC ready: both sensor streams returned samples')
        while not stopping:
            if any(child.poll() is not None for child in children):
                return 1
            time.sleep(0.1)
        return 0
    finally:
        for child in children:
            if child.poll() is None:
                child.terminate()
        for child in children:
            try:
                child.wait(timeout=3)
            except subprocess.TimeoutExpired:
                child.kill()
                child.wait()


if __name__ == '__main__':
    sys.exit(main())
