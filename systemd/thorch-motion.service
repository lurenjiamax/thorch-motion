[Unit]
Description=Experimental AYN Thor SSC sensor runtime
After=sound.target
RequiresMountsFor=/var/lib/aynthor/motion/runtime-root

[Service]
Type=exec
NotifyAccess=main
TimeoutStartSec=10
Restart=on-failure
RestartSec=5
ExecStart=/usr/lib/thorch-motion/supervisor /var/lib/aynthor/motion/runtime-root
User=root
Group=root
KillMode=control-group
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/aynthor/motion

[Install]
WantedBy=multi-user.target
