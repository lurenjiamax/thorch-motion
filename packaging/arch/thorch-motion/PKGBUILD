prepare() {
  cd "hexagonrpc-${_commit}"
  for patchfile in "${srcdir}"/000*.patch; do
    patch --batch --forward --fuzz=2 -p1 < "${patchfile}"
  done
  cd "${srcdir}/libssc"
  # Required final rotation rejection is checksum-pinned, never optional.
  for patchfile in "${_ssc_patches[@]}"; do
    patch --batch --forward --fuzz=0 -p1 < "${srcdir}/${patchfile}"
  done
}

build() {
  cd "hexagonrpc-${_commit}"
  # Native daemon only: no Meson test targets, registry generator or DSP programs.
  cc ${CFLAGS} -Iinclude libhexagonrpc/*.c hexagonrpcd/*.c \
    $(pkg-config --cflags --libs json-c) ${LDFLAGS} -o hexagonrpcd-thor
  bash "${startdir}/payload/build-private-ssc.sh" \
    "${srcdir}/libssc" "${srcdir}/build-private-ssc"
}

package() {
  install -Dm755 "hexagonrpc-${_commit}/hexagonrpcd-thor" "${pkgdir}/usr/lib/thorch-motion/hexagonrpcd"
  install -Dm755 "build-private-ssc/libssc.so.2" "${pkgdir}/usr/lib/thorch-motion/ssc/libssc.so.2"
  install -Dm755 "build-private-ssc/ssccli" "${pkgdir}/usr/lib/thorch-motion/ssc/ssccli"
  install -Dm755 "${startdir}/payload/thorch-motion-capture" "${pkgdir}/usr/bin/thorch-motion-capture"
  install -Dm755 "${startdir}/payload/thorch-motion-import" "${pkgdir}/usr/bin/thorch-motion-import"
  install -Dm755 "${startdir}/payload/thorch-motion-supervisor" "${pkgdir}/usr/lib/thorch-motion/supervisor"
  install -Dm644 "${startdir}/payload/thorch-motion.service" "${pkgdir}/usr/lib/systemd/system/thorch-motion.service"
  install -Dm644 "hexagonrpc-${_commit}/COPYING" "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
  install -Dm644 "libssc/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/libssc-LICENSE"
  install -Dm644 "${startdir}/README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 "${startdir}/payload/PROVENANCE.md" "${pkgdir}/usr/share/doc/${pkgname}/PROVENANCE.md"
  for patchfile in "${startdir}"/000*.patch; do
    install -Dm644 "${patchfile}" "${pkgdir}/usr/share/doc/${pkgname}/patches/${patchfile##*/}"
  done
  for patchfile in "${_ssc_patches[@]}"; do
    install -Dm644 "${startdir}/${patchfile}" "${pkgdir}/usr/share/doc/${pkgname}/patches/${patchfile}"
  done
  install -Dm644 "${startdir}/payload/build-private-ssc.sh" "${pkgdir}/usr/share/doc/${pkgname}/build-private-ssc.sh"
  # No public libssc ABI, headers, pkg-config, loader configuration or global symlinks.
  # Intentionally no install hook, enable/start operation or private runtime files.
}
