# Maintainer: Thorch contributors
pkgname=thorch-motion
pkgver=0.5.0
pkgrel=6
pkgdesc='Experimental opt-in AYN Thor SSC motion runtime (private device files required)'
arch=(aarch64)
url='https://github.com/linux-msm/hexagonrpc'
license=('GPL-3.0-or-later')
depends=(glibc json-c python libssc glib2 'libqmi>=1.33.4' protobuf-c)
makedepends=(gcc pkgconf patch protobuf)
_commit=dd9ac70c026e1bad93e8cffa3801255b8ceb551e
_ssc_commit=0cf77b93b55752da34dca2dcecc06fca8665184b
_ssc_patches=(libssc-placement-trace.patch
              libssc-sample-rate-override.patch
              libssc-cli-rate-capture.patch
              libssc-reject-invalid-rotation.patch)
source=("hexagonrpc-${_commit}.tar.gz::https://codeload.github.com/linux-msm/hexagonrpc/tar.gz/${_commit}"
        '0001-sscregistrygen-ignore-non-json-inputs.patch'
        '0002-hexagonrpcd-add-sns-registry-reverse-interface.patch'
        '0003-hexagonrpcd-keep-listener-registration-open.patch'
        '0004-hexagonrpcd-add-static-pd-option.patch'
        '0005-hexagonrpcd-add-writable-hexagonfs.patch'
        '0006-hexagonrpcd-support-writable-sensor-registry.patch'
        '0007-hexagonrpcd-support-large-and-extended-callbacks.patch'
        '0008-hexagonrpcd-enumerate-virtual-directories.patch'
        "libssc-${_ssc_commit}-codeberg.tar.gz::https://codeberg.org/DylanVanAssche/libssc/archive/${_ssc_commit}.tar.gz"
        "${_ssc_patches[@]}")
sha256sums=('575bf34b8e2a51f851b078cc4b87db3c9bb121ce5849be765352b016756d63eb'
